{
  "expo": {
    "name": "Wizdrif_0_2_3",
    "slug": "Wizdrif_0_2_3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./constants/images/brand/wizdriflogo_png.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./constants/images/brand/wizdriflogo_png.png",
      "resizeMode": "contain",
      "backgroundColor": "#050008"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services-(2).json",
      "package": "com.rnexpo.wizdrif",
      "adaptiveIcon": {
        "foregroundImage": "./constants/images/brand/wizdriflogo_png.png",
        "backgroundColor": "#050008"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wizdrif to access your photos",
          "cameraPermission": "Allow Wizdrif to access your camera",
          "microphonePermission": "Allow Wizdrif to access your microphone"
        }
      ],
      "expo-font",
      "expo-build-properties"
    ]
  }
}
